[Unit]
Description=Chidiya Ud leaderboard
After=network.target

[Service]
Type=simple
User=codex-deploy
Group=codex-deploy
WorkingDirectory=/srv/chidiya-ud
ExecStart=/usr/local/bin/chidiya-ud-leaderboard -addr 127.0.0.1:8082 -db /srv/chidiya-ud/data/chidiya-ud.db
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/chidiya-ud/data

[Install]
WantedBy=multi-user.target
